# Template only. pnpm setup:local generates random credentials in an ignored .env.
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
BACKOFFICE_ORIGIN=http://localhost:8080
JWT_SECRET=replace-with-jwt-secret
JWT_ISSUER=dwc-api
JWT_AUDIENCE=dwc-web
# Explicitly false only for local HTTP. Set true when using HTTPS.
AUTH_COOKIE_SECURE=false
MONGODB_URI=mongodb://127.0.0.1:27017/dwc?replicaSet=rs0&directConnection=true
# API Redis connection for readiness and authentication sessions.
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:4566
# Optional browser-facing endpoint for signed image URLs; defaults to S3_ENDPOINT.
# The Compose stack sets it because the API container reaches storage as storage:4566.
# S3_PUBLIC_ENDPOINT=http://127.0.0.1:4566
# Optional: address search provider (defaults to the public OpenStreetMap Nominatim).
# GEOCODER_URL=https://nominatim.openstreetmap.org
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=replace-with-local-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret-key
# Local administrator, created on API start if missing (never overwrites an existing
# account). Used for the backoffice and /api/admin. Remove both lines to disable.
ADMIN_BOOTSTRAP_NAME=Admin
ADMIN_BOOTSTRAP_EMAIL=admin@admin.com
ADMIN_BOOTSTRAP_PASSWORD=admin
