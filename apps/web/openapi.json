{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access JWT and HttpOnly dwc_refresh cookie. Session expires absolutely after 7 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or oversized input."
          },
          "401": {
            "description": "Invalid email or password."
          },
          "429": {
            "description": "At most 10 login attempts per IP per minute. Retry after the indicated delay."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Must equal configured WEB_ORIGIN, including non-browser clients.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rotates the refresh cookie once without extending the original session expiry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, invalid or reused cookie."
          },
          "403": {
            "description": "Missing or untrusted Origin."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "refresh": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "description": "Must equal configured WEB_ORIGIN.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revokes only this cookie session and clears the cookie. Also succeeds for absent or invalid cookies. Do not refresh/retry automatically."
          },
          "403": {
            "description": "Missing or untrusted Origin."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "refresh": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired or revoked access JWT, or missing user."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/auth/register": {
      "post": {
        "operationId": "UsersController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created. Registration does not sign the user in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unsupported role, or unknown/privileged field."
          },
          "409": {
            "description": "An account already uses this email."
          }
        },
        "summary": "Register a buyer or producer account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/payment-methods": {
      "post": {
        "operationId": "PaymentMethodsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentMethodDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethodResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired payment method metadata, or unexpected fields."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked access JWT."
          },
          "403": {
            "description": "Only buyers may manage payment methods."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Payment methods"
        ]
      },
      "get": {
        "operationId": "PaymentMethodsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentMethodResponseDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unexpected query fields are not accepted."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked access JWT."
          },
          "403": {
            "description": "Only buyers may manage payment methods."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Payment methods"
        ]
      }
    },
    "/api/producer/application": {
      "get": {
        "operationId": "ProducerApplicationController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current producer application and review status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerApplicationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Unexpected query fields are not accepted."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked access JWT."
          },
          "403": {
            "description": "Only producers may access producer applications."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Producer application"
        ]
      },
      "put": {
        "operationId": "ProducerApplicationController_submit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitProducerApplicationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application successfully saved or updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerApplicationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid application fields, bounds or unexpected properties."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked access JWT."
          },
          "403": {
            "description": "Only producers may access producer applications."
          },
          "409": {
            "description": "Only pending producer applications can be saved directly."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Producer application"
        ]
      }
    },
    "/api/producer/application/resubmit": {
      "post": {
        "operationId": "ProducerApplicationController_resubmit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitProducerApplicationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application successfully resubmitted for review.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerApplicationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid application fields, bounds or unexpected properties."
          },
          "401": {
            "description": "Missing, invalid, expired or revoked access JWT."
          },
          "403": {
            "description": "Only producers may access producer applications."
          },
          "409": {
            "description": "Only rejected producer applications can be resubmitted."
          },
          "503": {
            "description": "Authentication storage unavailable."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "Producer application"
        ]
      }
    }
  },
  "info": {
    "title": "From Farm to Table API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "refresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dwc_refresh"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "671f0f98ac53ba58e26c4789"
          },
          "name": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "example": "ana@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "buyer",
              "producer"
            ],
            "example": "buyer"
          },
          "producerStatus": {
            "type": "string",
            "enum": [
              null,
              "pending",
              "approved",
              "rejected",
              "suspended"
            ],
            "nullable": true,
            "example": null
          },
          "producerRejectionReason": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "producerStatus",
          "producerRejectionReason"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "enum": [
              900
            ]
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ana Silva",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "example": "ana@example.com",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "example": "long-enough-secret",
            "description": "Must be between 8 and 72 UTF-8 bytes; whitespace is preserved."
          },
          "role": {
            "type": "string",
            "enum": [
              "buyer",
              "producer"
            ],
            "example": "buyer"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "role"
        ]
      },
      "CreatePaymentMethodDto": {
        "type": "object",
        "properties": {
          "last4": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "example": "4242"
          },
          "expiryMonth": {
            "type": "number",
            "minimum": 1,
            "maximum": 12,
            "example": 6
          },
          "expiryYear": {
            "type": "number",
            "minimum": 1000,
            "maximum": 9999,
            "example": 2028
          }
        },
        "required": [
          "last4",
          "expiryMonth",
          "expiryYear"
        ]
      },
      "PaymentMethodResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$",
            "example": "65a0f1e5b9d4c0a1f2b3c4d5"
          },
          "last4": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "example": "4242"
          },
          "expiryMonth": {
            "type": "number",
            "minimum": 1,
            "maximum": 12
          },
          "expiryYear": {
            "type": "number",
            "minimum": 1000,
            "maximum": 9999
          },
          "expired": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "id",
          "last4",
          "expiryMonth",
          "expiryYear",
          "expired"
        ]
      },
      "ProducerApplicationDetailsDto": {
        "type": "object",
        "properties": {
          "farmName": {
            "type": "string",
            "example": "Quinta do Sol",
            "minLength": 1,
            "maxLength": 120,
            "description": "Public name of the farm or producer enterprise."
          },
          "description": {
            "type": "string",
            "example": "Family-owned organic vegetable farm specializing in heirloom tomatoes and seasonal greens.",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Detailed overview of farming practices, products, and story."
          },
          "locality": {
            "type": "string",
            "example": "Sintra",
            "minLength": 1,
            "maxLength": 120,
            "description": "Town, village or administrative locality."
          },
          "collectionAddress": {
            "type": "string",
            "example": "Rua Principal 12, 2710-001 Sintra",
            "minLength": 1,
            "maxLength": 240,
            "description": "Physical address for order collections and farm visits."
          },
          "latitude": {
            "type": "number",
            "example": 38.8029,
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude coordinate in decimal degrees between -90 and 90."
          },
          "longitude": {
            "type": "number",
            "example": -9.3817,
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude coordinate in decimal degrees between -180 and 180."
          }
        },
        "required": [
          "farmName",
          "description",
          "locality",
          "collectionAddress",
          "latitude",
          "longitude"
        ]
      },
      "ProducerApplicationResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "suspended"
            ],
            "example": "pending",
            "description": "Review status of the producer registration."
          },
          "rejectionReason": {
            "type": "string",
            "nullable": true,
            "example": null,
            "description": "Administrator explanation for application rejection, if rejected."
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2026-11-01T12:00:00.000Z",
            "description": "ISO-8601 timestamp of most recent application submission."
          },
          "application": {
            "nullable": true,
            "description": "Current submitted application details, or null if not yet submitted.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/ProducerApplicationDetailsDto"
              }
            ]
          }
        },
        "required": [
          "status",
          "rejectionReason",
          "submittedAt",
          "application"
        ]
      },
      "SubmitProducerApplicationDto": {
        "type": "object",
        "properties": {
          "farmName": {
            "type": "string",
            "example": "Quinta do Sol",
            "minLength": 1,
            "maxLength": 120,
            "description": "Public name of the farm or producer enterprise."
          },
          "description": {
            "type": "string",
            "example": "Family-owned organic vegetable farm specializing in heirloom tomatoes and seasonal greens.",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Detailed overview of farming practices, products, and story."
          },
          "locality": {
            "type": "string",
            "example": "Sintra",
            "minLength": 1,
            "maxLength": 120,
            "description": "Town, village or administrative locality."
          },
          "collectionAddress": {
            "type": "string",
            "example": "Rua Principal 12, 2710-001 Sintra",
            "minLength": 1,
            "maxLength": 240,
            "description": "Physical address for order collections and farm visits."
          },
          "latitude": {
            "type": "number",
            "example": 38.8029,
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude coordinate in decimal degrees between -90 and 90."
          },
          "longitude": {
            "type": "number",
            "example": -9.3817,
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude coordinate in decimal degrees between -180 and 180."
          }
        },
        "required": [
          "farmName",
          "description",
          "locality",
          "collectionAddress",
          "latitude",
          "longitude"
        ]
      }
    }
  }
}
