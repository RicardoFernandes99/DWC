{
  "name": "dwc",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.ts",
    "backoffice:setup": "node scripts/backoffice.ts setup",
    "backoffice:dev": "node scripts/backoffice.ts dev",
    "backoffice:check": "node scripts/backoffice.ts check",
    "backoffice:format": "node scripts/backoffice.ts format",
    "infra:up": "docker compose up -d --wait && pnpm --filter @dwc/api storage:init",
    "infra:down": "docker compose down",
    "stack:up": "docker compose --profile app up -d --build",
    "stack:down": "docker compose --profile app down",
    "stack:logs": "docker compose --profile app logs -f api web backoffice",
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @dwc/api dev\" \"pnpm --filter @dwc/web dev\"",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm contract:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "pnpm --filter @dwc/api smoke",
    "demo:install": "node .agents/install-demo-browser.ts",
    "demo:record": "node .agents/skills/record-demo/scripts/record-demo.ts",
    "demo:produce": "node .agents/skills/produce-demo/scripts/produce-demo.ts",
    "demo:test": "node --test .agents/skills/produce-demo/scripts/produce-demo.test.mjs .agents/skills/shared/html/index.test.mjs",
    "contract:generate": "pnpm --filter @dwc/api build && node apps/api/dist/export-web-contract.js && pnpm --filter @dwc/web exec openapi-typescript openapi.json -o src/lib/api-schema.ts",
    "contract:check": "pnpm --filter @dwc/api build && node apps/api/dist/export-web-contract.js --check && pnpm --filter @dwc/web exec openapi-typescript openapi.json -o src/lib/api-schema.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jiti": "^2.6.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.0",
    "typescript-eslint": "8.71.2"
  },
  "type": "module"
}
