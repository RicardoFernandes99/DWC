{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "eslint.config.ts",
    "scripts/**/*.ts",
    "apps/api/scripts/**/*.ts",
    "apps/web/scripts/**/*.ts"
  ]
}
